[Unit]
Description=gbot Intelligent Gateway Controller (Brain & Channels)
After=gmon.service

[Service]
Type=simple
# Run as dedicated gbot user
User=gbot
Group=gbot
ExecStart=/opt/gbot/venv/bin/python /opt/gbot/src/gbot/main.py
Restart=always
WorkingDirectory=/opt/gbot
# Pass Environment variables if needed
Environment=PYTHONPATH=/opt/gbot/src
Environment=GBOT_CONFIG_PATH=/etc/gbot/config.yml
Environment=GOOGLE_APPLICATION_CREDENTIALS=/etc/gbot/google_secret.json

[Install]
WantedBy=multi-user.target
