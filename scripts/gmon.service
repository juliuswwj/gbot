[Unit]
Description=gbot Network Monitor (Root, eBPF & Network Controls)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/gbot/src/gmon/mcp_server.py
Restart=always
WorkingDirectory=/usr/local/lib/gbot
User=root
# Automatically creates /run/gbot and clears it on stop
RuntimeDirectory=gbot
RuntimeDirectoryMode=0755
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
