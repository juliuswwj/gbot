[Unit]
Description=gbot Network Monitor (Root, eBPF & Network Controls)
After=network.target

[Service]
Type=simple
ExecStart=/opt/gbot/venv/bin/python /opt/gbot/src/gmon/mcp_server.py
Restart=always
WorkingDirectory=/opt/gbot
Environment=PYTHONPATH=/opt/gbot/src
User=root
# Automatically creates /run/gbot and clears it on stop
RuntimeDirectory=gbot
RuntimeDirectoryMode=0755
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
